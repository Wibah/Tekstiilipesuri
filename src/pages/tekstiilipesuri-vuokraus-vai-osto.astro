---
// SCN: tuki, intentti Decision, emopilari /. Sivun tehtävä on näyttää, milloin oma tekstiilipesuri kannattaa
// (Villen ohje 2026-10-05: emme vuokraa laitteita, joten sivu ohjaa ostamaan). Vuokrahinnat ovat laskelman vertailukohta. Hakusanat: tekstiilipesuri vuokraus 2 600, vuokraa tekstiilipesuri 200,
// kaupunkihaut (Oulu, Turku, Tampere, Helsinki, Jyväskylä, Espoo, Kuopio, Lahti, Joensuu ym.), kärcher tekstiilipesuri
// vuokraus 90 (Ahrefs 2026-10, yhteensä noin 5 950 hakua). Vuokraamoiden hinnat tiedostosta src/data/vuokrahinnat.json
// (tarkistettu käsin 2026-10-05). Kaupunkikohtaiset tiedot ovat vain niistä vuokraamoista, joiden sivut on tarkistettu.
// Kirjoitettu tekstiilipesuri-writer-skillillä (2026-10-05).
import Layout from '../layouts/Layout.astro';
import Murupolku from '../components/Murupolku.astro';
import VuokraTaulu from '../components/tuote/VuokraTaulu.astro';
import Tuotekortti from '../components/tuote/Tuotekortti.astro';
import Ukk from '../components/Ukk.astro';
import { paatuote, tuote, euroa, luku, paiva, mallisivut, sarjakuvaukset } from '../lib/tuotteet';

const se3 = await paatuote('SE 3');
const se3perus = await tuote('se-3-compact');
const se2 = await tuote('se-2-spot-care');
const akku = await tuote('se-3-18-compact-home-akulla');
const se4 = await paatuote('SE 4');
const puzzi = await paatuote('Puzzi 8/1');

// Halvin tarkistettu vuorokausivuokra (Pesurivuokraus.fi) ja kallein (Kärcher Center Vantaa).
const halvin = 39;
const kallein = 45;
const paivaa = (hinta: number) => luku(Math.round((hinta / halvin) * 10) / 10);
const laskelma = [
	{ t: se2, nimi: 'Kärcher SE 2 Spot Care', sivu: '/karcher-tekstiilipesurit/' },
	{ t: se3perus, nimi: 'Kärcher SE 3 Compact', sivu: mallisivut['SE 3'] },
	{ t: se3, nimi: 'Kärcher SE 3 Compact Floor', sivu: mallisivut['SE 3'] },
	{ t: se4, nimi: 'Kärcher SE 4 Plus', sivu: mallisivut['SE 4'] },
	{ t: puzzi, nimi: `Kärcher ${puzzi.nimi}`, sivu: mallisivut['Puzzi 8/1'] },
];

const kaupungit = [
	['Helsinki, Espoo ja Vantaa', 'Pesurivuokraus.fi (noutopisteet), Kärcher Center Vantaa'],
	['Tampere', 'Pesurivuokraus.fi (noutopiste)'],
	['Turku ja Raisio', 'Vuokraamo 24/7 Raisiossa (itsepalvelunouto ympäri vuorokauden)'],
	['Oulu ja Kempele', 'Pesurivuokraus.fi (noutopisteet), Kärcher Center Oulu'],
	['Jyväskylä', 'Pesurivuokraus.fi (noutopiste), Kärcher Center Jyväskylä'],
	['Lahti, Hämeenlinna ja Lappeenranta', 'Pesurivuokraus.fi (noutopisteet)'],
	['Vaasa, Seinäjoki, Mikkeli, Salo ja Nurmijärvi', 'Pesurivuokraus.fi (noutopisteet), Nurmijärvellä myös Kärcher Oy'],
];

const ukk = [
	{
		kysymys: 'Kannattaako tekstiilipesuri ostaa vai vuokrata?',
		vastaus: `Osta, jos peset useammin kuin muutaman kerran vuodessa tai haluat pestä tahrat heti. Kompaktin <a href="${mallisivut['SE 3']}">Kärcher SE 3 Compactin</a> hinnalla (${euroa(se3perus.hinta!)}) saa noin ${paivaa(se3perus.hinta!)} vuorokauden vuokran, joten oma laite maksaa itsensä takaisin muutamassa vuodessa. Jos peset vain kerran vuodessa, vuokraus on halvempi.`,
	},
	{
		kysymys: 'Mikä tekstiilipesuri kannattaa ostaa vuokraamisen sijaan?',
		vastaus: `Sohvaan, tuoleihin ja autoon riittää <a href="${mallisivut['SE 3']}">Kärcher SE 3 Compact</a>. Jos peset mattoja, valitse <a href="${mallisivut['SE 4']}">SE 4 Plus</a> (${euroa(se4.hinta!)}), jossa on ${luku(se4.tekniset.puhdasvesiL!)} litran säiliö ja lattiasuulake. Autoon ilman pistorasiaa sopii akkukäyttöinen <a href="${mallisivut['SE 3']}">SE 3-18 Compact Home</a> (${euroa(akku.hinta!)}).`,
	},
	{
		kysymys: 'Paljonko tekstiilipesurin vuokraus maksaa?',
		vastaus: `Tarkistamissamme vuokraamoissa Kärcher Puzzi 8/1 maksoi lokakuussa 2026 ${halvin}–${kallein} € vuorokaudelta. Kärcher Center Vantaa vuokraa sitä myös viikonlopuksi 60 eurolla ja viikoksi 150 eurolla.`,
	},
	{
		kysymys: 'Mistä voi vuokrata Kärcher-tekstiilipesurin?',
		vastaus: 'Kärcherin mukaan Kärcher Centerit Vantaalla, Jyväskylässä ja Oulussa sekä Kärcher Oy Nurmijärvellä vuokraavat Kärcher Professional -tekstiilipesureita. Kärcher Center Vantaa vuokraa Puzzi 8/1:tä, ja varaukset tehdään verkossa. Kärcher Puzzi 8/1 on myös Pesurivuokraus.fi:n ja Vuokraamo 24/7:n vuokralaite.',
	},
];
---
<Layout
	title="Tekstiilipesuri vuokraus vai oma? Hinnat ja milloin oma laite kannattaa (2026)"
	description={`Tekstiilipesuri vuokraus maksaa ${halvin}–${kallein} € vuorokaudelta. Laskimme, milloin oma tekstiilipesuri tulee vuokrausta halvemmaksi ja mikä malli kannattaa ostaa.`}
>
	<main class="article-layout">
		<Murupolku polku={[{ nimi: 'Etusivu', sivu: '/' }, { nimi: 'Tekstiilipesuri vuokraus vai osto', sivu: '/tekstiilipesuri-vuokraus-vai-osto/' }]} />
		<span class="tp-label">Opas</span>
		<h1>Tekstiilipesuri vuokraus vai osto – milloin oma tekstiilipesuri kannattaa?</h1>
		<p>Tekstiilipesurin vuokraus maksaa tarkistamissamme vuokraamoissa {halvin}–{kallein} € vuorokaudelta. Kompakti oma tekstiilipesuri maksaa Kärcher.comissa {euroa(se3perus.hinta!)}, eli saman verran kuin noin {paivaa(se3perus.hinta!)} vuokravuorokautta. Jos peset sohvaa, mattoja tai auton penkkejä useammin kuin muutaman kerran vuodessa, oma laite tulee halvemmaksi. Lisäksi se on käsillä heti, kun tahra syntyy.</p>

		<h2>Laskelma: oma tekstiilipesuri maksaa itsensä takaisin</h2>
		<p>Taulukko kertoo, montako vuorokautta laitteen hinnalla saa vuokrata halvimmasta tarkistamastamme vuokraamosta ({halvin} € / vrk). Pesuaine on jätetty laskelmasta pois, koska sitä tarvitaan kummassakin vaihtoehdossa.</p>
		<div class="tp-taulu">
			<table class="tp-versiot">
				<thead><tr><th scope="col">Oma laite</th><th scope="col">Hinta Kärcher.comissa</th><th scope="col">Vastaa vuokravuorokausia</th></tr></thead>
				<tbody>
					{laskelma.map(({ t, nimi, sivu }) => (
						<tr><th scope="row"><a href={sivu}>{nimi}</a></th><td>{euroa(t.hinta!)}</td><td>noin {paivaa(t.hinta!)}</td></tr>
					))}
				</tbody>
			</table>
		</div>
		<p class="tp-lahde">Laitteiden hinnat tarkistettu {paiva(se3.haettu)} Kärcher.comista.</p>
		<p>Kun pesukertoja on vuodessa kolme tai enemmän, kompakti oma laite maksaa itsensä takaisin parissa vuodessa. Vuokrauksessa jokainen pesukerta maksaa myös noudon ja palautuksen vaivan, eikä vuokralaite ole käsillä silloin, kun kahvi kaatuu sohvalle. Tuore tahra lähtee helpommin kuin kuivunut, ja tästä testit ovat yksimielisiä.</p>

		<h2>Osta oma tekstiilipesuri, jos…</h2>
		<ul>
			<li>kotona on lapsia tai lemmikkejä, ja tahroja tulee usein</li>
			<li>peset sohvaa, mattoja tai auton penkkejä useammin kuin muutaman kerran vuodessa</li>
			<li>haluat pestä tahrat heti, ennen kuin ne kuivuvat</li>
			<li>peset autoa usein (akkukäyttöinen <a href={mallisivut['SE 3']}>Kärcher SE 3-18</a> toimii ilman pistorasiaa)</li>
		</ul>

		<h2>Mikä tekstiilipesuri kannattaa ostaa?</h2>
		<p>Suosittelemme useimpiin koteihin Kärcher SE 3 Compactia. Se on pieni säilyttää ja pesee sohvat, tuolit ja auton penkit. Mattoihin suosittelemme SE 4 Plussaa, jonka puhdasvesisäiliö on {luku(se4.tekniset.puhdasvesiL!)} litraa, ja autoon akkukäyttöistä SE 3-18:aa.</p>
		<div class="mk-lista">
			<Tuotekortti tuote={se3} otsikko="Kärcher SE 3 Compact" sivu={mallisivut['SE 3']} kenelle={sarjakuvaukset['SE 3']} tagi="Suosituksemme kotiin" />
			<Tuotekortti tuote={se4} otsikko="Kärcher SE 4 Plus" sivu={mallisivut['SE 4']} kenelle={sarjakuvaukset['SE 4']} tagi="Matoille" />
			<Tuotekortti tuote={akku} otsikko="Kärcher SE 3-18 Compact Home" sivu={mallisivut['SE 3']} kenelle={sarjakuvaukset['SE 3-18']} tagi="Autoon" />
		</div>

		<h2>Tekstiilipesuri vuokra: hinnat vuokraamoissa</h2>
		<p>Tarkistimme kolmen vuokraamon hinnat. Kaikki kolme vuokraavat Kärcher Puzzi 8/1 -ammattilaitetta, jonka puhdasvesisäiliö on {luku(puzzi.tekniset.puhdasvesiL!)} litraa.</p>
		<VuokraTaulu />

		<h2>Vuokraa tekstiilipesuri, jos…</h2>
		<ul>
			<li>peset kerran vuodessa tai harvemmin</li>
			<li>pesettävää on kerralla paljon, esimerkiksi koko sohvakalusto ja isot matot muuton yhteydessä</li>
		</ul>
		<p>Puzzin {luku(puzzi.tekniset.puhdasvesiL!)} litran säiliö on lähes viisinkertainen SE 3 Compactin {luku(se3.tekniset.puhdasvesiL!)} litraan verrattuna, joten iso kertapesu käy vuokralaitteella nopeammin. Lue lisää <a href={mallisivut['Puzzi 8/1']}>Puzzi 8/1:stä</a>.</p>

		<h2>Tekstiilipesuri vuokraus paikkakunnittain</h2>
		<p>Lista kattaa vain ne kolme vuokraamoa, joiden sivut tarkistimme.</p>
		<div class="tp-taulu">
			<table class="tp-versiot">
				<thead><tr><th scope="col">Paikkakunta</th><th scope="col">Vuokraamot</th></tr></thead>
				<tbody>{kaupungit.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody>
			</table>
		</div>

		<Ukk kysymykset={ukk} />
	</main>
</Layout>
